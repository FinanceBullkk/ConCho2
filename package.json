{
  "name": "tms-v2",
  "version": "2.0.0",
  "description": "Training Management System v2 — Monorepo (client + server)",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:server": "cd server && npm ci --no-audit --no-fund",
    "install:client": "cd client && npm ci --include=dev --no-audit --no-fund",
    "build:client": "cd client && npm run build",
    "build": "npm run install:server && npm run install:client && npm run build:client",
    "start": "cd server && node server.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && node scripts/seed-pg.js",
    "seed:mongo": "cd server && node scripts/seed.js",
    "scripts:check": "node scripts/check-syntax.js",
    "data-safety:check": "node scripts/check-sensitive-data.js",
    "data-safety:test": "node --test scripts/check-sensitive-data.test.js"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
