{
  "name": "tms-v2",
  "version": "2.0.0",
  "description": "Training Management System v2 — Monorepo (client + server)",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install --include=dev",
    "build:client": "cd client && npm run build",
    "build": "npm run install:server && npm run install:client && npm run build:client",
    "start": "cd server && node server.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && node seed.js"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
