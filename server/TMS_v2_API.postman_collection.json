{
  "info": {
    "name": "TMS v2 API",
    "description": "Training Management System v2 — Full API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empCode\": \"ADMIN001\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Login (Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empCode\": \"TEACH001\",\n  \"password\": \"teacher123\"\n}"
            }
          }
        },
        {
          "name": "Login (Participant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empCode\": \"PART001\",\n  \"password\": \"participant123\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get Users (filtered by role)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?role=Participant&status=Active",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "role", "value": "Participant" },
                { "key": "status", "value": "Active" }
              ]
            }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empCode\": \"PART007\",\n  \"name\": \"New Participant\",\n  \"role\": \"Participant\",\n  \"department\": \"HR\",\n  \"password\": \"participant123\"\n}"
            }
          }
        },
        {
          "name": "Update User (change status → Dropped)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Dropped\"\n}"
            },
            "description": "TRIGGERS AUTO-RELEASE: removes user from all future schedules"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Teams (Admin)",
      "item": [
        {
          "name": "Get All Teams",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/teams"
          }
        },
        {
          "name": "Get Team By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/teams/{{teamId}}"
          }
        },
        {
          "name": "Create Team",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/teams",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Team\",\n  \"leaderId\": \"PASTE_LEADER_USER_ID\",\n  \"members\": [\"PASTE_MEMBER1_ID\", \"PASTE_MEMBER2_ID\"]\n}"
            }
          }
        },
        {
          "name": "Update Team Members (triggers sync)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/teams/{{teamId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"members\": [\"MEMBER_ID_1\", \"MEMBER_ID_2\"]\n}"
            },
            "description": "TRIGGERS DYNAMIC TEAM SYNC: auto-updates all future schedules"
          }
        },
        {
          "name": "Delete Team",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/teams/{{teamId}}"
          }
        }
      ]
    },
    {
      "name": "Classes",
      "item": [
        {
          "name": "Get All Classes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/classes"
          }
        },
        {
          "name": "Get Class By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/classes/{{classId}}"
          }
        },
        {
          "name": "Create Class (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/classes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classCode\": \"ENG-C1-2026\",\n  \"courseName\": \"Advanced English (C1)\",\n  \"status\": \"Ongoing\"\n}"
            }
          }
        },
        {
          "name": "Update Class (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/classes/{{classId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\"\n}"
            }
          }
        },
        {
          "name": "Delete Class (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/classes/{{classId}}"
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Get All Schedules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/schedules"
          }
        },
        {
          "name": "Get Schedules (filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/schedules?classId={{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"],
              "query": [
                { "key": "classId", "value": "{{classId}}" }
              ]
            }
          }
        },
        {
          "name": "Get Schedule By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/schedules/{{scheduleId}}"
          }
        },
        {
          "name": "Create Schedule (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"PASTE_CLASS_ID\",\n  \"date\": \"2026-05-01\",\n  \"timeSlot\": \"09:00-10:30\",\n  \"teacherId\": \"PASTE_TEACHER_ID\",\n  \"roomLink\": \"https://meet.google.com/xxx\",\n  \"capacity\": 10\n}"
            }
          }
        },
        {
          "name": "Book Team (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/{{scheduleId}}/book-team",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"PASTE_TEAM_ID\"\n}"
            },
            "description": "Enrolls all active team members into the schedule slot"
          }
        },
        {
          "name": "Cancel Team Booking (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/schedules/{{scheduleId}}/cancel-team",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"PASTE_TEAM_ID\"\n}"
            }
          }
        },
        {
          "name": "Update Schedule (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/schedules/{{scheduleId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomLink\": \"https://meet.google.com/updated\",\n  \"capacity\": 15\n}"
            }
          }
        },
        {
          "name": "Delete Schedule (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/schedules/{{scheduleId}}"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Bulk Mark Attendance (Teacher)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/attendance/{{scheduleId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    { \"userId\": \"PASTE_USER_ID_1\", \"status\": \"P\", \"remark\": \"On time\" },\n    { \"userId\": \"PASTE_USER_ID_2\", \"status\": \"A\" },\n    { \"userId\": \"PASTE_USER_ID_3\", \"status\": \"L\", \"remark\": \"10 min late\" },\n    { \"userId\": \"PASTE_USER_ID_4\", \"status\": \"EL\", \"remark\": \"Sick leave\" }\n  ]\n}"
            },
            "description": "Upserts attendance for entire class in one request"
          }
        },
        {
          "name": "Get Attendance by Schedule",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/attendance/schedule/{{scheduleId}}"
          }
        },
        {
          "name": "Get Attendance by User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/attendance/user/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Evaluations",
      "item": [
        {
          "name": "Upsert Evaluation (Teacher)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/evaluations",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"PASTE_CLASS_ID\",\n  \"userId\": \"PASTE_USER_ID\",\n  \"level\": \"B1\",\n  \"grammarScore\": 7.5,\n  \"vocabularyScore\": 8,\n  \"pronunciationScore\": 6.5,\n  \"fluencyScore\": 7,\n  \"teacherComment\": \"Good progress, needs pronunciation work\"\n}"
            }
          }
        },
        {
          "name": "Get All Evaluations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/evaluations"
          }
        },
        {
          "name": "Get Evaluations by Class",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/evaluations?classId={{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["evaluations"],
              "query": [
                { "key": "classId", "value": "{{classId}}" }
              ]
            }
          }
        },
        {
          "name": "Get Evaluation By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/evaluations/{{evaluationId}}"
          }
        },
        {
          "name": "Delete Evaluation (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/evaluations/{{evaluationId}}"
          }
        }
      ]
    },
    {
      "name": "Google Sheets Sync (Admin)",
      "item": [
        {
          "name": "Check Sync Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sync/status"
          }
        },
        {
          "name": "Sync from Google Sheets",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sync/google-sheets",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spreadsheetId\": \"YOUR_SPREADSHEET_ID\",\n  \"sheetName\": \"Sheet1\",\n  \"range\": \"A2:D\"\n}"
            },
            "description": "Reads rows from Master Sheet and enrolls teams into schedules"
          }
        }
      ]
    }
  ]
}
