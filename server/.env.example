# ──────────────────────────────────────────────────────────
# TMS v2 — Server environment template
# ──────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `server/.env` is gitignored AND dockerignored — never commit it.
# If you accidentally expose a secret, rotate it BEFORE pushing.
# ──────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# JWT_SECRET — REQUIRED. Server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-64-byte-random-hex

# JWT_EXPIRE — token lifetime. Default 1d.
JWT_EXPIRE=1d

# MONGO_URI — REQUIRED in production. Atlas replica set strongly recommended
# (transactions used by booking / enrollment / cancelSlot).
MONGO_URI=mongodb://localhost:27017/tms2

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allow-list. Production should NOT include localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Same origin as above, used by cookie / redirect helpers.
CLIENT_ORIGIN=http://localhost:5173

# ── Cron / scheduled tasks ────────────────────────────────
# CRON_TOKEN — bearer secret for /api/cron/* endpoints.
# Must be >= 16 chars in production (cronAuth refuses shorter).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_TOKEN=replace-me-with-32-byte-random-hex

# ── MFA ───────────────────────────────────────────────────
MFA_ISSUER=TMS
# Comma-separated list of roles that must enrol in MFA.
MFA_REQUIRED_ROLES=Admin

# ── Imports ───────────────────────────────────────────────
# REQUIRED in production. Import endpoint returns 500 if unset.
IMPORT_DEFAULT_PASSWORD=change-me-or-import-will-fail

# ── SMTP (password reset, reminders) ──────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=replace-me
EMAIL_FROM=TMS <noreply@example.com>

# ── Google Workspace (Calendar invites) ───────────────────
# Service-account JSON (single line). Leave empty to disable.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Calendar owner to impersonate.
GOOGLE_CALENDAR_IMPERSONATE=
TMS_TIMEZONE=Asia/Ho_Chi_Minh

# ── Web Push (B5 mobile learning surface) ─────────────────
# Generate a keypair once:  npx web-push generate-vapid-keys
# Leave empty to disable push delivery (subscribe + mobile feed still work).
# VAPID_PUBLIC_KEY is also served to the client via /api/me/push/vapid-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Observability ─────────────────────────────────────────
SENTRY_DSN=
# Release stamp is auto-read from GIT_SHA / RENDER_GIT_COMMIT (no var needed).

# ── PostgreSQL ────────────────────────────────────────────
# DB_BACKEND=postgres routes repositories at Postgres (prod, CI, tests are PG-only).
DB_BACKEND=postgres
# PG_URL — the LIVE database (Neon in prod). Used by the app when NOT in test mode.
PG_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb
#
# PG_TEST_URL — REQUIRED to run the Jest suite locally. The test harness
# TRUNCATEs every table, so it must point at a THROWAWAY local Postgres, never
# Neon. In NODE_ENV=test config/pg connects here (or a localhost PG_URL, as CI
# does) and FAILS CLOSED on any remote host — this is the guard that stops a
# repeat of the 2026-07-21 production wipe. Spin up a local DB with Docker:
#
#   docker run --rm -d --name tms-test-pg -e POSTGRES_PASSWORD=test \
#     -e POSTGRES_DB=tmstest -p 5544:5432 postgres:17
#   PG_TEST_URL=postgresql://postgres:test@localhost:5544/tmstest \
#     npx knex migrate:latest --knexfile db/pg/knexfile.js   # one-time schema
#
# PG_TEST_URL=postgresql://postgres:test@localhost:5544/tmstest

# ── Optional flags ────────────────────────────────────────
# Enable Swagger UI in production (default: dev-only).
# SWAGGER_ENABLED=false

# Auto-fail-fast bypass for missing CRON_TOKEN / IMPORT_DEFAULT_PASSWORD
# in non-production envs. Do NOT set in production.
# ALLOW_MISSING_PROD_ENV=true
