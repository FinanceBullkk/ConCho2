{
  "name": "tms-server",
  "version": "2.0.0",
  "description": "Training Management System v2 — Dynamic Slot-based Registration API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:smoke": "npx artillery run tests/load/smoke-test.yml",
    "test:load": "npx artillery run tests/load/load-test.yml",
    "test:spike": "npx artillery run tests/load/spike-test.yml",
    "test:load:report": "npx artillery run tests/load/load-test.yml --output tests/load/report.json && npx artillery report tests/load/report.json"
  },
  "dependencies": {
    "@sentry/node": "^10.51.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "googleapis": "^146.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "artillery": "^2.0.31",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.1.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
